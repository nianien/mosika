<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>mousika</artifactId>
        <groupId>io.github.nianien</groupId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>mousika-ui</artifactId>

    <properties>
        <spring-boot.version>3.4.5</spring-boot.version>
        <sqlite-jdbc.version>3.47.1.0</sqlite-jdbc.version>
        <!-- 父 POM 已将 spring-context 固定为 6.2.19，此处把 Spring Boot 管理的
             整个 spring-framework 家族一同上拉到 6.2.19，避免 spring-context 与
             spring-beans/spring-web 之间的方法签名错配（NoSuchMethodError）。 -->
        <spring-framework.version>6.2.19</spring-framework.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 先导入 spring-framework-bom：把整个 spring-* 家族强制拉到 6.2.19，
                 与父 POM 的 spring-context 版本对齐；spring-boot BOM 里对 spring-*
                 的管理会被此处已声明的版本覆盖（Maven 首次声明胜出规则）。 -->
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-framework-bom</artifactId>
                <version>6.2.19</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Boot 版本管理 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 父 POM 已将 logback-classic 固定为 1.5.38；同步覆盖 Boot BOM
                 管理的 logback-core 1.5.18，避免 provider 与 core 版本错配。 -->
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-core</artifactId>
                <version>${logback.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.github.nianien</groupId>
            <artifactId>mousika-core</artifactId>
            <version>${revision}</version>
            <scope>compile</scope>
        </dependency>

        <!-- Web 后端：轻量栈 Spring Boot Web + JdbcTemplate + SQLite，不引入 JPA/ORM -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- 父 POM 的 logback-classic 是 test scope；Web 运行时显式提供 SLF4J provider。 -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite-jdbc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- 保留形参名，避免 Spring MVC 因缺 -parameters 无法绑定
                         @RequestParam / @PathVariable 时报"Name for argument ... not specified" -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <mainClass>com.skyfalling.mousika.ui.web.MousikaWebApplication</mainClass>
                </configuration>
                <executions>
                    <!-- 绑定 repackage：mvn package 产出可执行的 Spring Boot 胖包，
                         可直接 java -jar mousika-ui/target/mousika-ui.jar 启动。 -->
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
